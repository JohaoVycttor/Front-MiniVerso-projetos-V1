# Copie este arquivo para .env.local e ajuste os valores.

# URL base da API Laravel (metaverso-back). As rotas ficam na raiz, sem /api. Ex.: http://localhost:8000
# Deixe vazio para o painel usar os dados de exemplo (mock).
API_URL=

# "mock" usa os dados de exemplo; "live" usa a API_URL.
# Se ficar vazio, o painel usa "live" quando a API_URL estiver preenchida.
API_MODE=mock

# Recursos que o back-end ainda não tem e continuam vindo do mock no modo live.
# Tire um item da lista quando a rota existir no back-end.
MOCK_RESOURCES=site-content,leads

# Endereço da área pública, usado no botão "Ver site".
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Encerra a sessão depois de X minutos sem uso (RNF14).
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# Validade máxima do cookie de sessão, em horas.
SESSION_MAX_AGE_HOURS=8

# Só para o modo mock: login de teste e atraso simulado das respostas.
MOCK_ADMIN_EMAIL=admin@miniverso.test
MOCK_ADMIN_PASSWORD=miniverso123
MOCK_LATENCY_MS=350
